---
title: Cookies
description: Don't use them.
keywords: http, cookies
date: 2026-09-28
---

<script>
  import { ChevronDown, ExternalLink } from '@lucide/svelte'

  const formattedDate = new Date(date).toLocaleDateString('en-US', {
